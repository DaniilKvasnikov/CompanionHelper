{
  "_readme": "Каталог параметров для захвата пресетов AOTO. Список растёт правкой этого файла - без кода. Каждый параметр: name (подпись), set {path, key, method?, extra?} - как POST'ить значение, get {path, field, method?} - как прочитать текущее (поле через точку). Необязательный map {'прочитанное': 'записываемое'} переводит значения чтения в значения записи (см. HDR: чтение SDR=1/HLG=2/PQ=3, запись SDR=2/HLG=3/PQ=4). RGB ScreenTest = три независимых параметра (setTestImage мержит по ключам - запись одного цвета не трогает другие; envelope в extra). ColorTemperature пишется через setColorTemple (так в прошивке).",
  "parameters": [
    {
      "name": "Вход",
      "set": { "path": "/ng_ctrl_sys/globalSettings/setScreenStatus", "key": "type" },
      "get": { "path": "/ng_ctrl_sys/globalSettings/getScreenStatus", "field": "obj.type" }
    },
    {
      "name": "Блэкаут",
      "set": { "path": "/ng_ctrl_sys/globalSettings/setScreenStatus", "key": "type" },
      "get": { "path": "/ng_ctrl_sys/globalSettings/getScreenStatus", "field": "obj.type" }
    },
    {
      "name": "Фриз",
      "set": { "path": "/ng_ctrl_sys/globalSettings/setScreenStatus", "key": "type" },
      "get": { "path": "/ng_ctrl_sys/globalSettings/getScreenStatus", "field": "obj.type" }
    },
    {
      "name": "Яркость",
      "set": { "path": "/ng_ctrl_sys/globalSettings/setBrightness", "key": "brightness" },
      "get": { "path": "/ng_ctrl_sys/globalSettings/getGlobalSettings", "field": "obj.brightness" }
    },
    {
      "name": "ColorTemperature",
      "set": { "path": "/ng_ctrl_sys/globalSettings/setColorTemple", "key": "colorTemperature" },
      "get": { "path": "/ng_ctrl_sys/globalSettings/getGlobalSettings", "field": "obj.colorTemperature" }
    },
    {
      "name": "ScreenTest R",
      "set": { "path": "/ng_ctrl_sys/input/setTestImage", "key": "testPicRedValue",
        "extra": { "areaId": 1, "testPicEn": 1, "testPicMode": 1, "testPicDeep": 1, "testPicPlayStatus": 0 } },
      "get": { "path": "/ng_ctrl_sys/input/getDataBaseInputInfo", "field": "obj.testPicRedValue" }
    },
    {
      "name": "ScreenTest G",
      "set": { "path": "/ng_ctrl_sys/input/setTestImage", "key": "testPicGreenValue",
        "extra": { "areaId": 1, "testPicEn": 1, "testPicMode": 1, "testPicDeep": 1, "testPicPlayStatus": 0 } },
      "get": { "path": "/ng_ctrl_sys/input/getDataBaseInputInfo", "field": "obj.testPicGreenValue" }
    },
    {
      "name": "ScreenTest B",
      "set": { "path": "/ng_ctrl_sys/input/setTestImage", "key": "testPicBlueValue",
        "extra": { "areaId": 1, "testPicEn": 1, "testPicMode": 1, "testPicDeep": 1, "testPicPlayStatus": 0 } },
      "get": { "path": "/ng_ctrl_sys/input/getDataBaseInputInfo", "field": "obj.testPicBlueValue" }
    },
    {
      "name": "HDR",
      "map": { "1": 2, "2": 3, "3": 4 },
      "set": {
        "path": "/ng_ctrl_sys/globalSettings/setHDR", "key": "hdrSetting",
        "extra": { "maximumBrightness": 10000, "coefficient": 1 }
      },
      "get": { "path": "/ng_ctrl_sys/globalSettings/getGlobalSettings", "field": "obj.hdrSetting" }
    }
  ]
}
